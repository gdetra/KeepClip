<Window
  x:Class="KeepClip.App.Settings.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Impostazioni · KeepClip">
  <Grid
    x:Name="Root"
    Background="{ThemeResource KeepClipPageBrush}">
    <Grid.Resources>
      <ResourceDictionary
        Source="ms-appx:///Appearance/ThemeResources.xaml" />
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer
      VerticalScrollBarVisibility="Auto">
      <StackPanel
        Padding="28"
        Spacing="18">
        <TextBlock
          Text="Impostazioni"
          FontSize="26"
          FontWeight="SemiBold"
          Foreground="{ThemeResource KeepClipTextBrush}" />
        <Border
          Background="{ThemeResource KeepClipSurfaceBrush}"
          BorderBrush="{ThemeResource KeepClipBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Padding="18">
          <StackPanel
            Spacing="14">
            <TextBlock
              Text="Editor del tema"
              FontSize="18"
              FontWeight="SemiBold"
              Foreground="{ThemeResource KeepClipTextBrush}" />
            <ComboBox
              x:Name="ThemeChoice"
              Header="Modalità"
              HorizontalAlignment="Stretch"
              SelectedIndex="{x:Bind Model.ThemeIndex, Mode=TwoWay}"
              AutomationProperties.AutomationId="SettingsWindow_ThemeChoice">
              <ComboBoxItem
                Content="Sistema" />
              <ComboBoxItem
                Content="Chiaro" />
              <ComboBoxItem
                Content="Scuro" />
            </ComboBox>
            <TextBlock
              Text="Palette predefinite"
              FontWeight="SemiBold"
              Foreground="{ThemeResource KeepClipTextBrush}" />
            <Grid
              x:Name="PaletteChoices"
              RowSpacing="8"
              ColumnSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition
                  Height="Auto" />
                <RowDefinition
                  Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="*" />
              </Grid.ColumnDefinitions>
            </Grid>
            <CheckBox
              x:Name="ColorSurfaces"
              Content="Colora anche sfondo e header delle card"
              IsChecked="{x:Bind Model.ColorSurfaces, Mode=TwoWay}"
              AutomationProperties.AutomationId="SettingsWindow_ColorSurfaces" />
            <TextBlock
              Text="Anteprima"
              FontSize="12"
              Foreground="{ThemeResource KeepClipSecondaryTextBrush}" />
            <Border
              BorderBrush="{ThemeResource KeepClipBorderBrush}"
              BorderThickness="1"
              Background="{ThemeResource KeepClipPageBrush}"
              CornerRadius="10"
              Padding="14">
              <Grid
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition
                    Width="*" />
                  <ColumnDefinition
                    Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                  Background="{ThemeResource KeepClipSurfaceBrush}"
                  BorderBrush="{ThemeResource KeepClipBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
                  <StackPanel>
                    <Border
                      Background="{ThemeResource KeepClipHeaderBrush}"
                      CornerRadius="7,7,0,0"
                      Padding="12">
                      <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">
                        <Image
                          Source="ms-appx:///Assets/AppLogo.png"
                          Width="32"
                          Height="32" />
                        <TextBlock
                          Text="KeepClip"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource KeepClipHeaderTextBrush}" />
                      </StackPanel>
                    </Border>
                    <StackPanel
                      Padding="12"
                      Spacing="6">
                      <TextBlock
                        Text="Esempio di testo copiato."
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource KeepClipTextBrush}" />
                      <TextBlock
                        Text="Testo · Adesso"
                        FontSize="11"
                        Foreground="{ThemeResource KeepClipAccentTextBrush}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Button
                  Grid.Column="1"
                  Content="Incolla"
                  IsTabStop="False"
                  Style="{StaticResource AccentButtonStyle}"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Anteprima del colore del pulsante Incolla"
                  AutomationProperties.AutomationId="SettingsWindow_Incolla" />
              </Grid>
            </Border>
            <TextBlock
              Text="L'anteprima modifica queste impostazioni. Salva per applicare il tema alla cronologia."
              TextWrapping="Wrap"
              FontSize="12"
              Foreground="{ThemeResource KeepClipSecondaryTextBrush}" />
            <Button
              Content="Ripristina tema predefinito"
              Command="{x:Bind Model.ResetThemeCommand}"
              AutomationProperties.AutomationId="SettingsWindow_Ripristinatemapredefinito" />
          </StackPanel>
        </Border>
        <ToggleSwitch
          x:Name="WindowsVShortcut"
          Header="Usa Win+V per aprire KeepClip"
          OffContent="Windows"
          OnContent="KeepClip"
          IsOn="{x:Bind Model.UseWindowsV, Mode=TwoWay}"
          AutomationProperties.AutomationId="SettingsWindow_WindowsVShortcut" />
        <TextBlock
          Text="Disattiva l’opzione e salva per restituire Win+V a Windows."
          TextWrapping="Wrap"
          FontSize="12"
          Foreground="{ThemeResource KeepClipSecondaryTextBrush}" />
        <TextBlock
          Text="Scorciatoia alternativa"
          FontWeight="SemiBold"
          Foreground="{ThemeResource KeepClipTextBrush}" />
        <StackPanel
          Orientation="Horizontal"
          Spacing="12">
          <ComboBox
            x:Name="Modifiers"
            SelectedIndex="{x:Bind Model.ModifierIndex, Mode=TwoWay}"
            AutomationProperties.AutomationId="SettingsWindow_Modifiers">
            <ComboBoxItem
              Content="Ctrl + Shift" />
            <ComboBoxItem
              Content="Ctrl + Alt" />
            <ComboBoxItem
              Content="Alt + Shift" />
          </ComboBox>
          <TextBox
            x:Name="Letter"
            Text="{x:Bind Model.Letter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            MaxLength="1"
            Width="72"
            Header="Lettera A–Z"
            AutomationProperties.AutomationId="SettingsWindow_Letter" />
        </StackPanel>
        <ToggleSwitch
          x:Name="Pause"
          Header="Cattura degli appunti"
          OffContent="In pausa"
          OnContent="Attiva"
          IsOn="{x:Bind Model.CaptureEnabled, Mode=TwoWay}"
          AutomationProperties.AutomationId="SettingsWindow_Pause" />
        <ToggleSwitch
          x:Name="CopySelection"
          Header="Copia alla selezione"
          OffContent="Disattivata"
          OnContent="Attiva"
          IsOn="{x:Bind Model.CopyOnSelection, Mode=TwoWay}"
          AutomationProperties.AutomationId="SettingsWindow_CopySelection" />
        <TextBlock
          Text="Copia il testo al rilascio del mouse quando viene riconosciuto come non modificabile. Esclude campi di input, editor, password e KeepClip, così puoi selezionare testo da sostituire senza perdere gli appunti. Nei campi di input o nei controlli non riconosciuti usa Ctrl+C; si sospende quando la cattura è in pausa."
          TextWrapping="Wrap"
          FontSize="12"
          Foreground="{ThemeResource KeepClipSecondaryTextBrush}" />
        <ToggleSwitch
          x:Name="CopySound"
          Header="Suono di conferma copia"
          OffContent="Disattivato"
          OnContent="Attivo"
          IsOn="{x:Bind Model.CopySound, Mode=TwoWay}"
          AutomationProperties.AutomationId="SettingsWindow_CopySound" />
        <StackPanel
          Spacing="8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="*" />
              <ColumnDefinition
                Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              Text="Volume del suono"
              Foreground="{ThemeResource KeepClipTextBrush}" />
            <TextBlock
              x:Name="SoundVolumeLabel"
              Grid.Column="1"
              Text="{x:Bind Model.SoundVolumeLabel, Mode=OneWay}"
              Foreground="{ThemeResource KeepClipTextBrush}" />
          </Grid>
          <Slider
            x:Name="SoundVolume"
            Minimum="0"
            Maximum="100"
            Value="{x:Bind Model.SoundVolume, Mode=TwoWay}"
            StepFrequency="1"
            TickFrequency="25"
            AutomationProperties.Name="Volume del suono di copia"
            AutomationProperties.AutomationId="SettingsWindow_SoundVolume" />
          <Button
            Content="Prova suono"
            Click="PreviewSound_Click"
            AutomationProperties.AutomationId="SettingsWindow_Provasuono" />
        </StackPanel>
        <ToggleSwitch
          x:Name="AutoStart"
          Header="Avvia all'accesso a Windows"
          OffContent="Disattivato"
          OnContent="Attivato"
          IsOn="{x:Bind Model.AutoStart, Mode=TwoWay}"
          IsEnabled="{x:Bind Model.StartupAvailable, Mode=OneWay}"
          AutomationProperties.AutomationId="SettingsWindow_AutoStart" />
        <TextBlock
          x:Name="StartupHint"
          Text="{x:Bind Model.StartupHint, Mode=OneWay}"
          TextWrapping="Wrap"
          Foreground="{ThemeResource KeepClipSecondaryTextBrush}" />
        <TextBlock
          Text="La cronologia salva testo, immagini e riferimenti a file e cartelle su questo dispositivo, fino a 200 elementi. I preferiti vengono conservati. Puoi sospendere la cattura quando copi dati sensibili."
          TextWrapping="Wrap"
          Foreground="{ThemeResource KeepClipTextBrush}" />
        <TextBlock
          x:Name="DataPathLabel"
          Text="{x:Bind Model.DataPathLabel, Mode=OneTime}"
          TextWrapping="Wrap"
          FontSize="11"
          Foreground="{ThemeResource KeepClipSecondaryTextBrush}" />
        <Button
          Content="Ripristina una cronologia danneggiata…"
          Click="Recover_Click"
          IsEnabled="{x:Bind Model.CanChangeSettings, Mode=OneWay}"
          AutomationProperties.AutomationId="SettingsWindow_Ripristinaunacronologiadanneggiata" />
      </StackPanel>
    </ScrollViewer>
    <Border
      Grid.Row="1"
      Padding="28,16"
      Background="{ThemeResource KeepClipSurfaceBrush}"
      BorderBrush="{ThemeResource KeepClipBorderBrush}"
      BorderThickness="0,1,0,0">
      <StackPanel
        Spacing="10">
        <InfoBar
          x:Name="Status"
          IsOpen="{x:Bind Model.IsStatusOpen, Mode=TwoWay}"
          Message="{x:Bind Model.StatusMessage, Mode=OneWay}"
          IsClosable="True"
          Severity="Informational" />
        <TextBlock
          Text="Le modifiche si applicano premendo Salva impostazioni."
          TextWrapping="Wrap"
          FontSize="12"
          Foreground="{ThemeResource KeepClipSecondaryTextBrush}" />
        <Button
          x:Name="SaveButton"
          Content="Salva impostazioni"
          Style="{StaticResource AccentButtonStyle}"
          Command="{x:Bind Model.SaveCommand}"
          AutomationProperties.AutomationId="SettingsWindow_SaveButton" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
