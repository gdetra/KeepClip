<Page
  x:Class="KeepClip.App.About.AboutPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="{ThemeResource KeepClipPageBrush}">
  <Page.Resources>
    <ResourceDictionary
      Source="ms-appx:///Appearance/ThemeResources.xaml" />
  </Page.Resources>
  <ScrollViewer
    HorizontalScrollBarVisibility="Disabled">
    <StackPanel
      Padding="24"
      Spacing="16">
      <Image
        Source="ms-appx:///Assets/AppLogo.png"
        Width="64"
        Height="64"
        HorizontalAlignment="Left"
        AutomationProperties.Name="Logo KeepClip" />
      <TextBlock
        Text="Informazioni su KeepClip"
        Style="{StaticResource TitleTextBlockStyle}"
        TextWrapping="Wrap" />
      <StackPanel
        Spacing="4">
        <TextBlock
          Text="Versione"
          Style="{StaticResource CaptionTextBlockStyle}" />
        <TextBlock
          Text="{x:Bind Model.Version, Mode=OneTime}"
          IsTextSelectionEnabled="True"
          TextWrapping="Wrap"
          AutomationProperties.AutomationId="About_Version" />
        <TextBlock
          Text="Build"
          Style="{StaticResource CaptionTextBlockStyle}" />
        <TextBlock
          Text="{x:Bind Model.Build, Mode=OneTime}"
          IsTextSelectionEnabled="True"
          TextWrapping="Wrap"
          AutomationProperties.AutomationId="About_Build" />
        <TextBlock
          Text="{x:Bind Model.Distribution, Mode=OneTime}"
          Style="{StaticResource CaptionTextBlockStyle}" />
      </StackPanel>
      <HyperlinkButton
        Content="Apri in Microsoft Store"
        NavigateUri="ms-windows-store://pdp/?productid=9PJTNS091173"
        HorizontalAlignment="Left"
        AutomationProperties.AutomationId="About_OpenStore" />
      <HyperlinkButton
        Content="Visita la pagina sul web"
        NavigateUri="https://apps.microsoft.com/detail/9pjtns091173?ocid=webpdpshare"
        HorizontalAlignment="Left"
        AutomationProperties.AutomationId="About_StoreWebsite" />
    </StackPanel>
  </ScrollViewer>
</Page>
