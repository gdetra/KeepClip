<UserControl
  x:Class="KeepClip.App.Shelf.ClipCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border
    Width="230"
    Height="224"
    Tapped="Card_Tapped"
    Background="{ThemeResource KeepClipSurfaceBrush}"
    BorderBrush="{ThemeResource KeepClipBorderBrush}"
    BorderThickness="1"
    CornerRadius="8">
    <Grid
      RowDefinitions="Auto,*,Auto">
      <Border
        Background="{ThemeResource KeepClipHeaderBrush}"
        CornerRadius="7,7,0,0"
        Padding="12,9">
        <Grid
          ColumnDefinitions="22,*"
          ColumnSpacing="8">
          <FontIcon
            x:Name="SourceFallback"
            Glyph=""
            FontSize="17"
            Foreground="{ThemeResource KeepClipHeaderTextBrush}"
            AutomationProperties.AccessibilityView="Raw" />
          <Image
            x:Name="SourceIcon"
            Width="22"
            Height="22"
            Stretch="Uniform"
            AutomationProperties.AccessibilityView="Raw" />
          <TextBlock
            x:Name="SourceName"
            Grid.Column="1"
            FontSize="13"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            Foreground="{ThemeResource KeepClipHeaderTextBrush}" />
        </Grid>
      </Border>
      <Grid
        Grid.Row="1"
        Margin="12,10">
        <TextBlock
          x:Name="PreviewText"
          FontSize="14"
          TextWrapping="Wrap"
          MaxLines="6"
          TextTrimming="CharacterEllipsis"
          Foreground="{ThemeResource KeepClipTextBrush}" />
        <Image
          x:Name="PreviewImage"
          Stretch="Uniform" />
      </Grid>
      <Grid
        Grid.Row="2"
        Margin="12,0,9,8"
        ColumnDefinitions="*,Auto,Auto"
        ColumnSpacing="4">
        <Grid.Resources>
          <Style
            x:Key="CardActionButtonStyle"
            TargetType="Button">
            <Setter
              Property="Width"
              Value="34" />
            <Setter
              Property="Height"
              Value="34" />
            <Setter
              Property="Padding"
              Value="0" />
            <Setter
              Property="CornerRadius"
              Value="{ThemeResource ControlCornerRadius}" />
            <Setter
              Property="HorizontalContentAlignment"
              Value="Center" />
            <Setter
              Property="VerticalContentAlignment"
              Value="Center" />
          </Style>
        </Grid.Resources>
        <StackPanel
          VerticalAlignment="Center"
          Spacing="2">
          <TextBlock
            x:Name="KindLabel"
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="{ThemeResource KeepClipTextBrush}" />
          <TextBlock
            x:Name="TimeLabel"
            FontSize="11"
            Foreground="{ThemeResource KeepClipSecondaryTextBrush}" />
        </StackPanel>
        <Button
          x:Name="PinButton"
          Grid.Column="1"
          Click="Pin_Click"
          Style="{StaticResource CardActionButtonStyle}"
          AutomationProperties.Name="Aggiungi ai preferiti"
          AutomationProperties.AutomationId="ClipCard_PinButton">
          <FontIcon
            x:Name="PinIcon"
            Glyph=""
            FontSize="16"
            AutomationProperties.AccessibilityView="Raw" />
        </Button>
        <Button
          Grid.Column="2"
          Click="Delete_Click"
          Style="{StaticResource CardActionButtonStyle}"
          ToolTipService.ToolTip="Elimina questa copia"
          AutomationProperties.Name="Elimina questa copia"
          AutomationProperties.AutomationId="ClipCard_Button2">
          <FontIcon
            Glyph=""
            FontSize="16"
            AutomationProperties.AccessibilityView="Raw" />
        </Button>
      </Grid>
    </Grid>
  </Border>
</UserControl>
