<Window
  x:Class="KeepClip.App.Shelf.ShelfWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:KeepClip.App.Shelf"
  Title="KeepClip">
  <Grid
    x:Name="Root"
    Background="{ThemeResource KeepClipPageBrush}"
    Padding="20,14"
    RowSpacing="10"
    KeyDown="Root_KeyDown">
    <Grid.Resources>
      <ResourceDictionary
        Source="ms-appx:///Appearance/ThemeResources.xaml" />
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
      <RowDefinition
        Height="Auto" />
    </Grid.RowDefinitions>
    <Grid
      ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          Width="Auto" />
        <ColumnDefinition
          Width="*" />
        <ColumnDefinition
          Width="Auto" />
        <ColumnDefinition
          Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel
        Orientation="Horizontal"
        Spacing="10"
        VerticalAlignment="Center">
        <Image
          Source="ms-appx:///Assets/AppLogo.png"
          Width="26"
          Height="26"
          Stretch="Uniform"
          AutomationProperties.AccessibilityView="Raw" />
        <TextBlock
          Text="KeepClip"
          FontSize="20"
          FontWeight="SemiBold"
          Foreground="{ThemeResource KeepClipTextBrush}" />
      </StackPanel>
      <TextBox
        x:Name="Search"
        Grid.Column="1"
        PlaceholderText="Cerca nella cronologia…"
        Text="{x:Bind Model.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        MaxWidth="480"
        HorizontalAlignment="Stretch"
        AutomationProperties.AutomationId="ShelfWindow_Search" />
      <ToggleButton
        Grid.Column="2"
        Content="Preferiti"
        IsChecked="{x:Bind Model.ShowPinnedOnly, Mode=TwoWay}"
        AutomationProperties.AutomationId="ShelfWindow_Preferiti" />
      <Button
        Grid.Column="3"
        Click="Settings_Click"
        ToolTipService.ToolTip="Impostazioni"
        AutomationProperties.Name="Impostazioni"
        AutomationProperties.AutomationId="ShelfWindow_Button3">
        <FontIcon
          Glyph="" />
      </Button>
    </Grid>
    <InfoBar
      x:Name="Status"
      Grid.Row="1"
      IsOpen="False"
      Severity="Informational"
      IsClosable="True" />
    <Grid
      Grid.Row="2">
      <GridView
        x:Name="Cards"
        Height="248"
        Padding="0"
        VerticalAlignment="Top"
        ItemsSource="{x:Bind Model.Entries, Mode=OneWay}"
        SelectedItem="{x:Bind Model.SelectedEntry, Mode=TwoWay}"
        SelectionMode="Single"
        IsItemClickEnabled="False"
        ScrollViewer.HorizontalScrollMode="Enabled"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        ScrollViewer.VerticalScrollMode="Disabled"
        ScrollViewer.VerticalScrollBarVisibility="Disabled"
        AutomationProperties.AutomationId="ShelfWindow_Cards">
        <GridView.ItemContainerStyle>
          <Style
            TargetType="GridViewItem">
            <Setter
              Property="Padding"
              Value="0" />
            <Setter
              Property="Margin"
              Value="0,0,10,0" />
            <Setter
              Property="VerticalAlignment"
              Value="Top" />
          </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemsPanel>
          <ItemsPanelTemplate>
            <ItemsWrapGrid
              Orientation="Vertical"
              MaximumRowsOrColumns="1" />
          </ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemTemplate>
          <DataTemplate>
            <local:ClipCard
              PasteRequested="Card_PasteRequested"
              PinRequested="Card_PinRequested"
              DeleteRequested="Card_DeleteRequested" />
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>
      <StackPanel
        x:Name="EmptyState"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Spacing="8">
        <FontIcon
          Glyph=""
          FontSize="30"
          Foreground="{ThemeResource KeepClipAccentTextBrush}" />
        <TextBlock
          x:Name="EmptyText"
          Text="Copia qualcosa per iniziare"
          FontSize="18"
          Foreground="{ThemeResource KeepClipTextBrush}" />
        <TextBlock
          Text="Testo, immagini e file saranno disponibili qui."
          Foreground="{ThemeResource KeepClipSecondaryTextBrush}" />
      </StackPanel>
    </Grid>
    <Grid
      Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          Width="*" />
        <ColumnDefinition
          Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
        Content="Svuota…"
        Click="Clear_Click"
        HorizontalAlignment="Left"
        AutomationProperties.AutomationId="ShelfWindow_Svuota" />
      <TextBlock
        x:Name="CountLabel"
        Grid.Column="1"
        VerticalAlignment="Center"
        Foreground="{ThemeResource KeepClipSecondaryTextBrush}" />
    </Grid>
  </Grid>
</Window>
