  <Resources>
    <Resource
      Language="it-IT" />
  </Resources>
  <Applications>
    <Application
      Id="App"
      Executable="KeepClip.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="KeepClip"
        Description="Cronologia personale degli appunti"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension
          Category="windows.startupTask"
          Executable="KeepClip.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="KeepClipStartup"
            Enabled="false"
            DisplayName="KeepClip" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability
      Name="runFullTrust" />
  </Capabilities>
</Package>
